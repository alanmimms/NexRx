/ {
	display_header: display-header {
		gpio-map =
		<0 0 &gpioa 4 0>,  /* PA4: SPI /CS (in software) */
		<1 0 &gpiog 2 0>,  /* PG2: D/C pin */
		<2 0 &gpiog 3 0>;  /* PG3: RESET pin */
	};

	chosen {
		zephyr,console = &usart3;
		zephyr,shell_uart = &usart3;
	};
};

&usart3 {
	status = "okay";
	current-speed = <115200>;
};

&spi1 {
	status = "okay";
	pinctrl-0 = <&spi1_sck_pb3 &spi1_mosi_pb5>;
	pinctrl-names = "default";
	cs-gpios = <&display_header 0 GPIO_ACTIVE_LOW>;
};
