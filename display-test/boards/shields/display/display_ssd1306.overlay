/ {
	chosen {
		zephyr,display = &disp;
	};
};


&spi1 {
	status = "okay";

	disp: display@0 {
		compatible = "solomon,ssd1306fb";
		reg = <0>;
		spi-max-frequency = <10000000>;
		width = <128>;
		height = <64>;

		data-cmd-gpios = <&display_header 1 GPIO_ACTIVE_HIGH>;
		reset-gpios    = <&display_header 2 GPIO_ACTIVE_LOW>;

		segment-offset = <0>;
		page-offset = <0>;
		display-offset = <0>;
		multiplex-ratio = <63>;
		segment-remap;
		com-invdir;
		prechargep = <0x22>;
	};
};
