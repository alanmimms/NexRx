/dts-v1/;
#include <st/h7/stm32h743Xi.dtsi>
#include <st/h7/stm32h743vitx-pinctrl.dtsi>
#include <zephyr/dt-bindings/memory-attr/memory-attr-arm.h>

/delete-node/ &sram1;

/ {
	model = "NexRx Receiver Board";
	compatible = "nexrx,nexrx-rx";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,nocache = &sram1_nocache;
		zephyr,dtcm = &dtcm;
		zephyr,console = &usart1;
		zephyr,shell-uart = &usart1;
		zephyr,udc0 = &usbotg_fs;
		zephyr,display = &disp;
	};

	aliases {
		si5351-i2c = &i2c1;
		display-spi = &spi2;
		cpld-spi = &spi3;
		osd-spi = &spi4;

		gnss-uart = &uart7;
	};

	/* Shrink sram1 so it starts after our 8KB carve-out */
	sram1: memory@30002000 {
		compatible = "mmio-sram";
		reg = <0x30002000 0x0001e000>;
	};

	/* Carve out the 8KB (0x2000 bytes) naturally aligned at 0x30000000 */
	sram1_nocache: memory@30000000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0x30000000 0x00002000>;
		zephyr,memory-region = "SRAM1_NOCACHE";
		zephyr,memory-attr = <( DT_MEM_ARM(ATTR_MPU_RAM_NOCACHE) )>;
	};

	cpld0: cpld0 {
		compatible = "nexrx,cpld-ice40";
		nss-gpios = <&gpioa 4 GPIO_ACTIVE_LOW>;
		done-gpios = <&gpioe 0 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpioe 1 GPIO_ACTIVE_LOW>;
		status = "okay";
	};

	cpld1: cpld1 {
		compatible = "nexrx,cpld-ice40";
		nss-gpios = <&gpioa 15 GPIO_ACTIVE_LOW>;
		status = "okay";
	};

	adc_reset: adc_reset {
		compatible = "nexrx,adc-reset";
		gpios = <&gpioa 6 GPIO_ACTIVE_LOW>;
		status = "okay";
	};

	bpf_switches: bpf_switches {
		compatible = "nexrx,bpf-switches";
		bpf1-gpios = <&gpiod 1 GPIO_ACTIVE_HIGH>;
		bpf2-gpios = <&gpiod 0 GPIO_ACTIVE_HIGH>;
		bpf3-gpios = <&gpiod 5 GPIO_ACTIVE_HIGH>;
		bpf4-gpios = <&gpiod 4 GPIO_ACTIVE_HIGH>;
		hpf-gpios = <&gpiod 2 GPIO_ACTIVE_HIGH>;
		nhpf-gpios = <&gpiod 3 GPIO_ACTIVE_LOW>;
		status = "okay";
	};

	atten_switches: atten_switches {
		compatible = "nexrx,atten-switches";
		atten-3db-gpios = <&gpiod 10 GPIO_ACTIVE_HIGH>;
		atten-6db-gpios = <&gpiod 7 GPIO_ACTIVE_HIGH>;
		atten-12db-gpios = <&gpiod 8 GPIO_ACTIVE_HIGH>;
		atten-24db-gpios = <&gpiod 9 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	power_control: power_control {
		compatible = "nexrx,power-control";
		enable-3v3-gpios = <&gpiod 6 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	status_leds: status_leds {
		compatible = "nexrx,status-leds";
		red-gpios = <&gpiob 9 GPIO_ACTIVE_LOW>;
		green-gpios = <&gpiob 8 GPIO_ACTIVE_LOW>;
		blue-gpios = <&gpioe 6 GPIO_ACTIVE_LOW>;
		status = "okay";
	};

	gnss_reset: gnss_reset {
		compatible = "nexrx,gnss-reset";
		reset-gpios = <&gpiob 3 GPIO_ACTIVE_LOW>;
		status = "okay";
	};

	si5351_OEB: si5351_OEB {
		compatible = "nexrx,si5351-OEB";
		oe-gpios = <&gpiob 4 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	zephyr,user {
		/* USB-C CC Monitor ADC Channels */
		io-channels = <&adc1 7>, <&adc1 8>;
		io-channel-names = "CC2_ADC", "CC1_ADC";
	};

	display_header: display-header {
		compatible = "zephyr,gpio-nexus";
		#gpio-cells = <2>;
		gpio-map =
		  <0 0 &gpioa 11 0>,  /* PA11: SPI /CS (in software) */
		  <1 0 &gpioe 13 0>,  /* PE13: D/C pin */
		  <2 0 &gpioe 12 0>;  /* PE12: RESET pin */
	};
};


&usbotg_fs {
	status = "okay";

	pinctrl-0 = <&usb_otg_hs_ulpi_ck_pa5 &usb_otg_hs_ulpi_d0_pa3
		     &usb_otg_hs_ulpi_d1_pb0 &usb_otg_hs_ulpi_d2_pb1
		     &usb_otg_hs_ulpi_d3_pb10 &usb_otg_hs_ulpi_d4_pb11
		     &usb_otg_hs_ulpi_d5_pb12 &usb_otg_hs_ulpi_d6_pb13
		     &usb_otg_hs_ulpi_d7_pb5 &usb_otg_hs_ulpi_dir_pc2_c
		     &usb_otg_hs_ulpi_nxt_pc3_c &usb_otg_hs_ulpi_stp_pc0>;
	pinctrl-names = "default";

	usb_device_0: usb_device_0 {
		compatible = "zephyr,usb-device";
		status = "okay";

		console_uart: cdc_acm_uart0 {
			compatible = "zephyr,cdc-acm-uart";
			label = "NexRx Console";
		};

		control_plane_uart: cdc_acm_uart1 {
			compatible = "zephyr,cdc-acm-uart";
			label = "NexRx Control Plane";
		};

		iq_data_pump: iq_data_pump {
			compatible = "zephyr,usb-vendor-bulk";
			status = "okay";
		};
	};
};

&adc1 {				/* USB CC1/CC2 pin sense */
	pinctrl-0 = <&adc1_inp7_pa7 &adc1_inp8_pc5>;
	pinctrl-names = "default";
	st,adc-clock-source = "SYNC";
	st,adc-prescaler = <4>;
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;


	usbcc2_adc: channel@7 {
		reg = <7>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
	usbcc1_adc: channel@8 {
		reg = <8>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};

&i2c1 {				/* clk (Si5351) I2C */
	pinctrl-0 = <&i2c1_scl_pb6 &i2c1_sda_pb7>;
	pinctrl-names = "default";
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
};

&clk_hse {
	clock-frequency = <DT_FREQ_M(26)>;
	status = "okay";
};

&pll {
	div-m = <13>;
	mul-n = <400>;
	div-p = <2>;
	div-q = <2>;
	div-r = <2>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(400)>;
	d1cpre = <1>;
	hpre = <2>;
	d1ppre = <2>;
	d2ppre2 = <2>;
	d2ppre1 = <2>;
	d3ppre = <2>;
};

&usart1 {			/* FACTORY UART test pads */
	pinctrl-0 = <&usart1_tx_pb14 &usart1_rx_pb15>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&uart7 {			/* GNSS UART */
	pinctrl-0 = <&uart7_tx_pe8 &uart7_rx_pe7>;
	pinctrl-names = "default";
	current-speed = <9600>;
	status = "okay";
};


&spi3 {				/* CPLD0/CPLD1 */
	status = "okay";
	pinctrl-0 = <&spi3_sck_pc10 &spi3_miso_pc11 &spi3_mosi_pb2>;
	pinctrl-names = "default";
	cs-gpios = <&gpioa 4 GPIO_ACTIVE_LOW>, <&gpioa 15 GPIO_ACTIVE_LOW>;
};

&spi2 {				/* Display */
	status = "okay";
	pinctrl-0 = <&spi2_sck_pa9 &spi2_mosi_pc1>;
	pinctrl-names = "default";
	cs-gpios = <&display_header 0 GPIO_ACTIVE_LOW>;
};

&spi4 {				/* OSD0/OSD1 */
	pinctrl-0 = <&spi4_sck_pe2 &spi4_mosi_pe14 &spi4_miso_pe5>;
	pinctrl-names = "default";
	cs-gpios = <&gpioe 3 GPIO_ACTIVE_LOW>, <&gpioe 4 GPIO_ACTIVE_LOW>;
	status = "okay";

	osd0_adc: tlv320adc5140@0 {
		compatible = "ti,tlv320adc5140";
		reg = <0>;
		spi-max-frequency = <10000000>;
	};

	osd1_adc: tlv320adc5140@1 {
		compatible = "ti,tlv320adc5140";
		reg = <1>;
		spi-max-frequency = <10000000>;
	};
};

&pwr {
	power-supply = "ldo";
};

