/dts-v1/;
#include <st/h7/stm32h743Xi.dtsi>
#include <st/h7/stm32h743vitx-pinctrl.dtsi>
#include <zephyr/dt-bindings/memory-attr/memory-attr-arm.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/delete-node/ &sram1;

/ {
	model = "NexRx Receiver Board";
	compatible = "nexrx,nexrx-rx";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,nocache = &sram1_nocache;
		zephyr,dtcm = &dtcm;
		//		zephyr,console = &console_uart;
		//		zephyr,shell-uart = &console_uart;
		zephyr,console = &factory_console;
		zephyr,shell-uart = &factory_console;
		zephyr,udc0 = &usbotg_hs;
		zephyr,display = &disp;
	};

	aliases {
		si5351-i2c = &i2c1;
		display-spi = &spi2;
		cpld-spi = &spi3;
		osd-spi = &spi4;

		gnss-uart = &uart7;
	};

	/* Shrink sram1 so it starts after our 8KB carve-out */
	sram1: memory@30002000 {
		compatible = "mmio-sram";
		reg = <0x30002000 0x0001e000>;
	};

	/* Carve out the 8KB (0x2000 bytes) naturally aligned at 0x30000000 */
	sram1_nocache: memory@30000000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0x30000000 0x00002000>;
		zephyr,memory-region = "SRAM1_NOCACHE";
		zephyr,memory-attr = <( DT_MEM_ARM(ATTR_MPU_RAM_NOCACHE) )>;
	};

	cpld0: cpld0 {
		compatible = "nexrx,cpld-ice40";
		nss-gpios = <&gpioa 4 GPIO_ACTIVE_LOW>;
		done-gpios = <&gpioe 0 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpioe 1 GPIO_ACTIVE_LOW>;
		status = "okay";
	};

	cpld1: cpld1 {
		compatible = "nexrx,cpld-ice40";
		nss-gpios = <&gpioa 15 GPIO_ACTIVE_LOW>;
		status = "okay";
	};

	adc_reset: adc_reset {
		compatible = "nexrx,adc-reset";
		gpios = <&gpioa 6 GPIO_ACTIVE_LOW>;
		status = "okay";
	};

	bpf_switches: bpf_switches {
		compatible = "nexrx,bpf-switches";
		bpf1-gpios = <&gpiod 1 GPIO_ACTIVE_HIGH>;
		bpf2-gpios = <&gpiod 0 GPIO_ACTIVE_HIGH>;
		bpf3-gpios = <&gpiod 5 GPIO_ACTIVE_HIGH>;
		bpf4-gpios = <&gpiod 4 GPIO_ACTIVE_HIGH>;
		hpf-gpios = <&gpiod 2 GPIO_ACTIVE_HIGH>;
		nhpf-gpios = <&gpiod 3 GPIO_ACTIVE_LOW>;
		status = "okay";
	};

	atten_switches: atten_switches {
		compatible = "nexrx,atten-switches";
		atten-3db-gpios = <&gpiod 10 GPIO_ACTIVE_HIGH>;
		atten-6db-gpios = <&gpiod 7 GPIO_ACTIVE_HIGH>;
		atten-12db-gpios = <&gpiod 8 GPIO_ACTIVE_HIGH>;
		atten-24db-gpios = <&gpiod 9 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	power_control: power_control {
		compatible = "nexrx,power-control";
		enable-3v3-gpios = <&gpiod 6 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	pwmleds {
		compatible = "pwm-leds";

		// Red and blue are swapped in the pinout on EVT boards.
		// XXX Fix this and reverse them back on future boards.
		red_pwm_led: red_pwm_led {
			pwms = <&pwm15 2 PWM_HZ(417) PWM_POLARITY_NORMAL>;
		};
		green_pwm_led: green_pwm_led {
			pwms = <&pwm4 3 PWM_HZ(417) PWM_POLARITY_NORMAL>;
		};
		blue_pwm_led: blue_pwm_led {
			pwms = <&pwm4 4 PWM_HZ(417) PWM_POLARITY_NORMAL>;
		};
	};

	gnss_reset: gnss_reset {
		compatible = "nexrx,gnss-reset";
		reset-gpios = <&gpiob 3 GPIO_ACTIVE_LOW>;
		status = "okay";
	};

	si5351_OEB: si5351_OEB {
		compatible = "nexrx,si5351-oeb";
		oe-gpios = <&gpiob 4 GPIO_ACTIVE_LOW>;
		status = "okay";
	};

	zephyr,user {
		/* USB-C CC Monitor ADC Channels */
		io-channels = <&adc1 7>, <&adc1 8>;
		io-channel-names = "CC2_ADC", "CC1_ADC";
		usb-phy-reset-gpios = <&gpioc 4 GPIO_ACTIVE_LOW>;
	};

	display_header: display-header {
		compatible = "zephyr,gpio-nexus";
		#gpio-cells = <2>;
		gpio-map =
		<0 0 &gpioa 11 0>,  /* PA11: SPI /CS (in software) */
		<1 0 &gpioe 13 0>,  /* PE13: D/C pin */
		<2 0 &gpioe 12 0>;  /* PE12: RESET pin */
	};

	soc {
		usbotg_hs: usb@40040000 {
			compatible = "st,stm32-otghs";
			reg = <0x40040000 0x40000>;
			interrupts = <74 0>, <75 0>, <76 0>, <77 0>;
			interrupt-names = "ep1_out", "ep1_in", "wkup", "otghs";
			num-bidir-endpoints = <9>;
			ram-size = <4096>;
			maximum-speed = "full-speed";
			clocks = <&rcc STM32_CLOCK(AHB1, 25)>,
			<&rcc STM32_SRC_HSI48 USB_SEL(3)>;
			phys = <&otghs_fs_phy>;
			status = "disabled";
		};
	};

	usbhs_ulpi_phy: usbhs_ulpi_phy {
		compatible = "usb-ulpi-phy";
		#phy-cells = <0>;
		reset-gpios = <&gpioc 4 GPIO_ACTIVE_LOW>;
	};
};

&timers4 {
  status = "okay";
  st,prescaler = <239>;

  pwm4: pwm {
    status = "okay";
    pinctrl-0 = <&tim4_ch3_pb8 &tim4_ch4_pb9>;
    pinctrl-names = "default";
  };
};

&timers15 {
  status = "okay";
  st,prescaler = <239>;

  pwm15: pwm {
    status = "okay";
    pinctrl-0 = <&tim15_ch2_pe6>;
    pinctrl-names = "default";
  };
};

&pinctrl {
	usb_otg_hs_ulpi_ck_pa5 {
		slew-rate = "very-high-speed";
	};
	usb_otg_hs_ulpi_d0_pa3 {
		slew-rate = "very-high-speed";
	};
	usb_otg_hs_ulpi_d1_pb0 {
		slew-rate = "very-high-speed";
	};
	usb_otg_hs_ulpi_d2_pb1 {
		slew-rate = "very-high-speed";
	};
	usb_otg_hs_ulpi_d3_pb10 {
		slew-rate = "very-high-speed";
	};
	usb_otg_hs_ulpi_d4_pb11 {
		slew-rate = "very-high-speed";
	};
	usb_otg_hs_ulpi_d5_pb12 {
		slew-rate = "very-high-speed";
	};
	usb_otg_hs_ulpi_d6_pb13 {
		slew-rate = "very-high-speed";
	};
	usb_otg_hs_ulpi_d7_pb5 {
		slew-rate = "very-high-speed";
	};
	usb_otg_hs_ulpi_stp_pc0 {
		slew-rate = "very-high-speed";
	};
	usb_otg_hs_ulpi_dir_pc2_c {
		slew-rate = "very-high-speed";
	};
	usb_otg_hs_ulpi_nxt_pc3_c {
		slew-rate = "very-high-speed";
	};
};

&usbotg_hs {
	pinctrl-0 = <&usb_otg_hs_ulpi_ck_pa5
	&usb_otg_hs_ulpi_d0_pa3
	&usb_otg_hs_ulpi_d1_pb0
	&usb_otg_hs_ulpi_d2_pb1
	&usb_otg_hs_ulpi_d3_pb10
	&usb_otg_hs_ulpi_d4_pb11
	&usb_otg_hs_ulpi_d5_pb12
	&usb_otg_hs_ulpi_d6_pb13
	&usb_otg_hs_ulpi_d7_pb5
	&usb_otg_hs_ulpi_stp_pc0
	&usb_otg_hs_ulpi_dir_pc2_c
	&usb_otg_hs_ulpi_nxt_pc3_c>;
	pinctrl-names = "default";
	clocks = <&rcc STM32_CLOCK_BUS_AHB1 0x06000000>,
	<&rcc STM32_SRC_HSI48 USB_SEL(3)>;
	phys = <&usbhs_ulpi_phy>;
	maximum-speed = "high-speed";
	status = "okay";

	console_uart: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
		label = "NexRx Console";
	};

	control_plane_uart: cdc_acm_uart1 {
		compatible = "zephyr,cdc-acm-uart";
		label = "NexRx Control Plane";
	};
};

&usbotg_fs {
	status = "disabled";
};

&adc1 {				/* USB CC1/CC2 pin sense */
	pinctrl-0 = <&adc1_inp7_pa7 &adc1_inp8_pc5>;
	pinctrl-names = "default";
	st,adc-clock-source = "SYNC";
	st,adc-prescaler = <4>;
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;


	usbcc2_adc: channel@7 {
		reg = <7>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
	usbcc1_adc: channel@8 {
		reg = <8>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};

&i2c1 {				/* clk (Si5351) I2C */
	pinctrl-0 = <&i2c1_scl_pb6 &i2c1_sda_pb7>;
	pinctrl-names = "default";
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
};

&clk_hse {
	// This will change to 40MHz TCXO in future hw builds
	clock-frequency = <DT_FREQ_M(26)>;
	status = "okay";
};

&mco2 {
	// This will change to when we switch to 40MHz TCXO in future hw builds
	clocks = <&rcc STM32_SRC_HSE MCO2_SEL(2)>;
	prescaler = <MCO2_PRE(MCO_PRE_DIV_1)>;
	pinctrl-0 = <&rcc_mco_2_pc9>;
	pinctrl-names = "default";
	status = "okay";
};

&rcc_mco_2_pc9 {
	slew-rate = "medium-speed"; /* or "high-speed" */
};

&clk_hsi48 {
	status = "okay";
};

&pll {
	div-m = <13>;
	mul-n = <400>;
	div-p = <2>;
	div-q = <2>;
	div-r = <2>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(400)>;
	d1cpre = <1>;
	hpre = <2>;
	d1ppre = <2>;
	d2ppre2 = <2>;
	d2ppre1 = <2>;
	d3ppre = <2>;
};

factory_console: &usart1 {			/* FACTORY UART test pads */
	pinctrl-0 = <&usart1_tx_pb14 &usart1_rx_pb15>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&uart7 {			/* GNSS UART */
	pinctrl-0 = <&uart7_tx_pe8 &uart7_rx_pe7>;
	pinctrl-names = "default";
	current-speed = <9600>;
	status = "okay";
};


&spi3 {				/* CPLD0/CPLD1 */
	status = "okay";
	pinctrl-0 = <&spi3_sck_pc10 &spi3_miso_pc11 &spi3_mosi_pb2>;
	pinctrl-names = "default";
	cs-gpios = <&gpioa 4 GPIO_ACTIVE_LOW>, <&gpioa 15 GPIO_ACTIVE_LOW>;
};

&spi3_miso_pc11 {
	/delete-property/ bias-pull-down;
	bias-pull-up;		/* XXX TEMPORARY HACK */
};


&spi2 {				/* Display */
	status = "okay";
	pinctrl-0 = <&spi2_sck_pa9 &spi2_mosi_pc1>;
	pinctrl-names = "default";
	cs-gpios = <&display_header 0 GPIO_ACTIVE_LOW>;
};

&spi4 {				/* OSD0/OSD1 */
	pinctrl-0 = <&spi4_sck_pe2 &spi4_mosi_pe14 &spi4_miso_pe5>;
	pinctrl-names = "default";
	cs-gpios = <&gpioe 3 GPIO_ACTIVE_LOW>, <&gpioe 4 GPIO_ACTIVE_LOW>;
	status = "okay";

	osd0_adc: tlv320adc5140@0 {
		compatible = "ti,tlv320adc5140";
		reg = <0>;
		spi-max-frequency = <10000000>;
	};

	osd1_adc: tlv320adc5140@1 {
		compatible = "ti,tlv320adc5140";
		reg = <1>;
		spi-max-frequency = <10000000>;
	};
};

&pwr {
	power-supply = "ldo";
};

