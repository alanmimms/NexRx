/dts-v1/;
#include <st/h7/stm32h743Xi.dtsi>
#include <st/h7/stm32h743vitx-pinctrl.dtsi>
#include <zephyr/dt-bindings/mipi_dbi/mipi_dbi.h>

/ {
	model = "NexRx Receiver Board";
	compatible = "nexrx,nexrx-rx";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,dtcm = &dtcm;
		zephyr,console = &usart6;
		zephyr,shell-uart = &usart6;
		zephyr,display = &st7789v;
		zephyr,udc0 = &usbotg_fs;
	};

	cpld0: cpld0 {
		compatible = "nexrx,cpld-ice40";
		nss-gpios = <&gpioa 4 GPIO_ACTIVE_LOW>;
		status = "okay";
	};

	codec: codec {
		compatible = "nexrx,ak5578";
		reset-gpios = <&gpioa 6 GPIO_ACTIVE_LOW>;
		status = "okay";
	};

	zephyr,user {
		/* USB-C CC Monitor ADC Channels */
		io-channels = <&adc1 7>, <&adc1 8>;
		io-channel-names = "CC2_ADC", "CC1_ADC";
	};
};


&usbotg_fs {
	status = "okay";

	pinctrl-0 = <&usb_otg_hs_ulpi_ck_pa5 &usb_otg_hs_ulpi_d0_pa3
		     &usb_otg_hs_ulpi_d1_pb0 &usb_otg_hs_ulpi_d2_pb1
		     &usb_otg_hs_ulpi_d3_pb10 &usb_otg_hs_ulpi_d4_pb11
		     &usb_otg_hs_ulpi_d5_pb12 &usb_otg_hs_ulpi_d6_pb13
		     &usb_otg_hs_ulpi_d7_pb5 &usb_otg_hs_ulpi_dir_pc2_c
		     &usb_otg_hs_ulpi_nxt_pc3_c &usb_otg_hs_ulpi_stp_pc0>;
	pinctrl-names = "default";



	usb_device_0: usb_device_0 {
		compatible = "zephyr,usb-device";
		status = "okay";

		cdc_acm_uart0: cdc_acm_uart0 {
			compatible = "zephyr,cdc-acm-uart";
			label = "CDC_ACM_0";
		};

		cdc_acm_uart1: cdc_acm_uart1 {
			compatible = "zephyr,cdc-acm-uart";
			label = "CDC_ACM_1";
		};

		iq_data_pump: iq_data_pump {
			compatible = "zephyr,usb-vendor-bulk";
			status = "okay";
		};
	};
};

&adc1 {
	pinctrl-0 = <&adc1_inp7_pa7 &adc1_inp8_pc5>;
	pinctrl-names = "default";
	st,adc-clock-source = "SYNC";
	st,adc-prescaler = <4>;
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;


	channel@7 {
		reg = <7>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
	channel@8 {
		reg = <8>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};

&i2c4 {
	pinctrl-0 = <&i2c4_scl_pd12 &i2c4_sda_pd13>;
	pinctrl-names = "default";
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
};

&clk_hse {
	clock-frequency = <DT_FREQ_M(26)>;
	status = "okay";
};

&pll {
	div-m = <13>;
	mul-n = <400>;
	div-p = <2>;
	div-q = <2>;
	div-r = <2>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(400)>;
	d1cpre = <1>;
	hpre = <2>;
	d1ppre = <2>;
	d2ppre2 = <2>;
	d2ppre1 = <2>;
	d3ppre = <2>;
};

&usart6 {
	pinctrl-0 = <&usart6_tx_pc6>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&uart7 {
	pinctrl-0 = <&uart7_tx_pe8 &uart7_rx_pe7>;
	pinctrl-names = "default";
	current-speed = <9600>;
	status = "okay";
};


&spi3 {
	pinctrl-0 = <&spi3_sck_pc10 &spi3_miso_pc11 &spi3_mosi_pb2>;
	pinctrl-names = "default";
	status = "okay";
};

&spi2 {
	pinctrl-0 = <&spi2_sck_pa9 &spi2_mosi_pc1>;
	pinctrl-names = "default";
	cs-gpios = <&gpioa 11 GPIO_ACTIVE_LOW>;
	status = "okay";

	mipi_dbi_st7789v {
		compatible = "zephyr,mipi-dbi-spi";
		spi-dev = <&spi2>;
		dc-gpios = <&gpioe 13 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpioe 12 GPIO_ACTIVE_LOW>;
		write-only;
		#address-cells = <1>;
		#size-cells = <0>;

		st7789v: st7789v@0 {
			compatible = "sitronix,st7789v";
			mipi-max-frequency = <32000000>;
			reg = <0>;
			width = <240>;
			height = <135>;
			x-offset = <0>;
			y-offset = <40>;
			vcom = <0x19>;
			gctrl = <0x35>;
			vrhs = <0x12>;
			vdvs = <0x20>;
			mdac = <0x00>;
			gamma = <0x01>;
			colmod = <0x05>;
			lcm = <0x2c>;
			porch-param = [0c 0c 00 33 33];
			cmd2en-param = [33 06 04];
			pwctrl1-param = [a4 a1];
			pvgam-param = [d0 04 0d 11 13 2b 3f 54 4c 18 0d 0b 1f 23];
			nvgam-param = [d0 04 0c 11 13 2c 3f 44 51 2f 1f 1f 20 23];
			ram-param = [00 f0];
			rgb-param = [cd 08 14];
			mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
		};
	};
};

&spi4 {
	pinctrl-0 = <&spi4_sck_pe2 &spi4_mosi_pe14>;
	pinctrl-names = "default";
	cs-gpios = <&gpioe 4 GPIO_ACTIVE_LOW>;
	status = "okay";
};

