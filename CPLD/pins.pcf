# Clock Inputs
set_io clkOSDpin 20
set_io clkTCXOpin 29
set_io gnssPPSpin 32

# SPI Interface
set_io cpldMISOpin 12
set_io cpldSCLKpin 15
set_io cpldNSSpin 14
set_io cpldMOSIpin 13

# Octature clock outputs
set_io nPh[0] 1
set_io nPh[1] 5
set_io nPh[2] 8
set_io nPh[3] 2
set_io nPh[4] 18
set_io nPh[5] 22
set_io nPh[6] 23
set_io nPh[7] 19
