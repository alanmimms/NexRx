/*
 * SPDX-License-Identifier: MIT
 * NexRx Digital Twin - Device Tree Overlay for native_sim
 *
 * Defines virtual peripherals that map to the twin simulation.
 */

/ {
    chosen {
        zephyr,console = &uart0;
        zephyr,shell-uart = &uart0;
    };

    /* Virtual NCO control interface */
    nexrx_nco: nexrx_nco {
        compatible = "nexrx,virtual-nco";
        label = "NEXRX_NCO";
        status = "okay";
        /* Two NCO channels for dual-OSD */
        num-channels = <2>;
    };

    /* Virtual ADC interface (I/Q from simulation) */
    nexrx_adc: nexrx_adc {
        compatible = "nexrx,virtual-adc";
        label = "NEXRX_ADC";
        status = "okay";
        /* 4 channels: I0, Q0, I1, Q1 */
        num-channels = <4>;
        sample-rate = <384000>;
        resolution = <24>;
    };

    /* Virtual preselector control */
    nexrx_presel: nexrx_presel {
        compatible = "nexrx,virtual-presel";
        label = "NEXRX_PRESEL";
        status = "okay";
    };

    /* Virtual attenuator control */
    nexrx_atten: nexrx_atten {
        compatible = "nexrx,virtual-atten";
        label = "NEXRX_ATTEN";
        status = "okay";
    };
};
